# Model provider
ANTHROPIC_API_KEY=sk-ant-...
MODEL_ID=claude-sonnet-5-5

# Sandbox targets: where a bot's computer lives. See sandboxes.example.json.
# A target can be local docker or a remote daemon (ssh:// or a docker context).
# Each bot picks one; switching moves it to a different machine, and the
# workspace there is separate.
SANDBOX_CONFIG=./sandboxes.json

# Single-target shortcut, used when SANDBOX_CONFIG is absent:
#   SANDBOX_DRIVER=docker   isolated, needs a running daemon
#   SANDBOX_DRIVER=local    NO isolation, dev only (also needs SANDBOX_ALLOW_LOCAL=1)
SANDBOX_DRIVER=local
SANDBOX_IMAGE=node:22-bookworm

# MCP servers to load (see mcp.example.json)
MCP_CONFIG=./mcp.json

# Egress policy for the sandbox. Omit for allow_all.
#   mode: allow_all | defaults_plus_allowlist | allowlist_only
#   applyToMcp: also hold remote MCP servers to this list. An allowlist does NOT
#               restrict MCP servers unless this is true.
# Only enforced by the docker driver; the local driver has no network control.
# EGRESS_POLICY={"mode":"defaults_plus_allowlist","allowed":["internal.corp"],"applyToMcp":true}

# Server
PORT=4000
DB_PATH=./data/app.db

# Budgets per run
MAX_STEPS=24
MAX_TOKENS=400000
MAX_WALLCLOCK_MS=900000

# Context window budget per model call. Older turns are summarized into the
# system prompt once they no longer fit.
MAX_CONTEXT_TOKENS=120000

# Internal AI gateway (anthropic-messages compatible). Interpolated into pi's
# model config as $ADA_TOKEN at load time; never written to disk by us.
ADA_TOKEN=ada_...
# Your gateway's base URL, e.g. http://gateway.internal.example.com
ADA_BASE_URL=
PI_MODEL=kr-claude-opus-5.5

# Bearer token for the local API. Generated into .env on first run if absent.
AUTH_TOKEN=
